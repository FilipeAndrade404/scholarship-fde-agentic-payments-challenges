{
  "name": "filipe-andrade-infra",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --noEmit && npm run build:tools && npm run build:agent && npm run build:chat && npm run build:frontend",
    "build:frontend": "npm --prefix ../frontend ci && npm --prefix ../frontend run build",
    "build:tools": "npm --prefix ../tools run build && esbuild ../tools/src/handler.ts --bundle --platform=node --target=node24 --outfile=dist/payment-tools/index.js",
    "build:agent": "uv run --no-project --python 3.13 python ../agent/build.py",
    "build:chat": "npm --prefix ../api run build && esbuild ../api/src/handler.ts --bundle --platform=node --target=node24 --outfile=dist/chat/index.js && esbuild ../api/src/cognito.ts --bundle --platform=node --target=node24 --outfile=dist/initialize-user/index.js",
    "synth": "npm run build && cdk synth",
    "deploy": "npm run build && cdk deploy"
  },
  "dependencies": {
    "aws-cdk-lib": "2.276.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "aws-cdk": "^2.1148.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
